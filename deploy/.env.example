# deploy/.env — 服务器上的运行时密钥(不进git)
# 部署脚本会自动生成。已经有的键不会覆盖, 包括 LIQUOR_APP_PASSWORD。
POSTGRES_PASSWORD=CHANGE_ME_AUTOGEN
# API 使用的业务角色。不是超级用户, 不是表主。见 deploy/README.md 的验证 SQL。
LIQUOR_APP_PASSWORD=CHANGE_ME_AUTOGEN
JWT_SECRET=CHANGE_ME_AUTOGEN
TAG=latest
# 浏览器跨域白名单（逗号分隔，禁止 *）。不设置或留空 = 生产不允许跨域。
# H5 与 API 不同源时填写，例如 https://h5.example.com
# CORS_ORIGINS=
