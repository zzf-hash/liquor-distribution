{
  "name": "@liquor/api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "dev": "tsc -p tsconfig.json --watch",
    "prisma:generate": "prisma generate",
    "test": "pnpm -C ../../packages/shared run build && pnpm exec prisma generate && node ./scripts/run-jest.cjs",
    "seed": "tsc -p tsconfig.seed.json && node dist-seed/seed.js && node prisma/seed-p1.js && node prisma/seed-demo.js"
  },
  "dependencies": {
    "@liquor/shared": "workspace:*",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.15",
    "@prisma/client": "^6.2.1",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dayjs": "^1.11.13",
    "express": "4.22.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.10.5",
    "jest": "^29.7.0",
    "prisma": "^6.2.1",
    "ts-jest": "^29.1.2",
    "typescript": "^5.6.3"
  }
}