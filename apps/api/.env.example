# 复制为 .env 使用; 生产密钥由 deploy/deploy.sh 首次部署时自动生成, 禁止入库
DATABASE_URL=postgresql://liquor:CHANGE_ME@localhost:5432/liquor
JWT_SECRET=CHANGE_ME_MIN_32_CHARS
PORT=3000
# ── 飞书通知(两种模式二选一; 都不填=静默关闭) ──
# 模式A 应用级(推荐): open.feishu.cn 自建应用, 功能多(群/个人/卡片)
FEISHU_APP_ID=             # 应用 App ID
FEISHU_APP_SECRET=         # 应用 App Secret
FEISHU_CHAT_ID=            # 默认通知群 chat_id(机器人拉进群后 oc_xxx)
# 模式B 群机器人 webhook(兜底): 群设置→群机器人→自定义机器人
FEISHU_WEBHOOK_URL=
FEISHU_SECRET=             # 签名密钥(开了签名校验才填)
