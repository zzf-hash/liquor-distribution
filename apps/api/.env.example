# 复制为 .env 使用; 生产密钥由 deploy/deploy.sh 首次部署时自动生成, 禁止入库
DATABASE_URL=postgresql://liquor:CHANGE_ME@localhost:5432/liquor
JWT_SECRET=CHANGE_ME_MIN_32_CHARS
PORT=3000
# ── 飞书通知(两种模式二选一; 都不填=静默关闭) ──
# 模式A 应用级(推荐): open.feishu.cn 自建应用, 功能多(群/个人/卡片)
FEISHU_APP_ID=             # 应用 App ID
FEISHU_APP_SECRET=         # 应用 App Secret
FEISHU_CHAT_ID=            # 默认通知群 chat_id(机器人拉进群后 oc_xxx)
# 模式B 群机器人 webhook(兜底): 群设置→群机器人→自定义机器人
FEISHU_WEBHOOK_URL=
FEISHU_SECRET=             # 签名密钥(开了签名校验才填)
# ── 腾讯云 ASR(C组 M12-1 语音下单转写; 不填=小程序语音页回退手敲文字) ──
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
# ── 浏览器跨域白名单 CORS_ORIGINS（逗号分隔，禁止 *）──
# 不写这一行 = 未设置:
#   NODE_ENV=production → 不允许任何跨域（管理端走同源 nginx 反代，不受影响）
#   其它环境 → 默认放行本地 H5 http://127.0.0.1:10086、http://localhost:10086
#             以及管理端 http://127.0.0.1:5173、http://localhost:5173
# 写了这一行（哪怕为空）就只认列出的来源，不再套用上面的开发默认。
# 生产 H5 与 API 不同源时在运行环境显式设置，例如:
# CORS_ORIGINS=https://h5.example.com
