# 复制为 .env 使用; 生产密钥由 deploy/deploy.sh 首次部署时自动生成, 禁止入库
# API 用 liquor_app。prisma migrate deploy 用表主 liquor (MIGRATE_DATABASE_URL)。
# 本地若还没建 liquor_app, 可以两个 URL 暂时都指向 liquor; 启动会打 error 日志, 但不拒绝启动。
# 建角色: DATABASE_URL=$MIGRATE_DATABASE_URL pnpm exec prisma db execute --schema prisma/schema.prisma --file prisma/grant-liquor-app.sql
# 上线验证 SQL 见 deploy/README.md (rolsuper/rolbypassrls 应为 f, FORCE RLS 的表应为 45 张)。
DATABASE_URL=postgresql://liquor_app:CHANGE_ME@localhost:5432/liquor
MIGRATE_DATABASE_URL=postgresql://liquor:CHANGE_ME@localhost:5432/liquor
JWT_SECRET=CHANGE_ME_MIN_32_CHARS
PORT=3000
# ── 飞书通知(两种模式二选一; 都不填=静默关闭) ──
# 模式A 应用级(推荐): open.feishu.cn 自建应用, 功能多(群/个人/卡片)
FEISHU_APP_ID=             # 应用 App ID
FEISHU_APP_SECRET=         # 应用 App Secret
FEISHU_CHAT_ID=            # 默认通知群 chat_id(机器人拉进群后 oc_xxx)
# 模式B 群机器人 webhook(兜底): 群设置→群机器人→自定义机器人
FEISHU_WEBHOOK_URL=
FEISHU_SECRET=             # 签名密钥(开了签名校验才填)
# ── 腾讯云 ASR(C组 M12-1 语音下单转写; 不填=小程序语音页回退手敲文字) ──
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
