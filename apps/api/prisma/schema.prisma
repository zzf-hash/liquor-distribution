// 酒类分销订货商城 — Prisma Schema (P0)
// 安全基线: docs/M0/安全评审-01.md 阻断项 B1~B5 全部落表
//   B1 账号禁用即时生效  → User.token_version (JWT 携带, 校验比对, 禁用/改密/改角色即 bump)
//   B2 审计 append-only  → AuditLog.prev_row_hash/row_hash 哈希链 (仅 INSERT+SELECT, Prisma 层禁 update/delete)
//   B3 订单明细不可改    → OrderLine 金额/单价一次写入, 禁 UPDATE (改单只走红字冲销行 reversalOfId)
//   B4 余额禁直改        → 库存/应收余额均为流水投影 (InventoryLedger/ReceivableLedger append-only, 无可直接改的余额列)
//   B5 租户第一天进表    → 全部业务表 tenant_id NOT NULL + 复合索引首列

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── 基础: 租户 / 用户 / 权限 ─────────────────────────

model Tenant {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  createdAt DateTime @default(now())

  users        User[]
  products     Product[]
  customers    Customer[]
  orders       SalesOrder[]
  receivables  Receivable[]
  payments     Payment[]
  auditLogs    AuditLog[]
}

enum Role {
  OWNER    // 企业主
  REP      // 业务员
  CLERK    // 内勤出纳
  WAREHOUSE // 仓配
  CUSTOMER // 客户(外部身份, P1-1 信道分离)
}

enum DataScope {
  ALL           // 老板/内勤: 全租户
  SELF          // 业务员: 自己相关
  OWN_CUSTOMERS // 业务员: 自己客户
  SELF_ORDER    // 客户: 自己订单
}

enum UserStatus {
  ACTIVE
  DISABLED
}

model User {
  id           String     @id @default(cuid())
  tenantId     String
  username     String
  passwordHash String? // 客户(微信)P0 无口令; 员工账密必填
  name         String
  role         Role
  dataScope    DataScope
  tokenVersion Int        @default(0) // B1: JWT 携带版本, 不符即 401
  status       UserStatus @default(ACTIVE)
  phone        String?
  customerId   String? // role=CUSTOMER 时绑定的客户档案
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  tenant           Tenant         @relation(fields: [tenantId], references: [id])
  customer         Customer?      @relation("CustomerLoginUser", fields: [customerId], references: [id])
  salesOf          Customer[]     @relation("CustomerSalesperson")
  ordersCreated    SalesOrder[]   @relation("OrderCreator")
  paymentsReported Payment[]      @relation("PaymentReporter")
  paymentsEntered  Payment[]      @relation("PaymentClerk")
  auditLogs        AuditLog[]
  approvalsAsApplicant ApprovalRecord[] @relation("ApprovalApplicant")

  @@unique([tenantId, username])
  @@index([tenantId, role])
}

// ───────────────────────── P0-T10 商品档案 ─────────────────────────

enum ProductCategory {
  BAIJIU  // 白酒
  PIJIU   // 啤酒
  HONGJIU // 红酒
  YANGJIU // 洋酒
  YINLIAO // 饮料
  QITA    // 其他
}

enum ProductStatus {
  ON_SALE
  OFF_SALE
}

model Product {
  id          String          @id @default(cuid())
  tenantId    String
  skuCode     String // 商户现用编码沿用 (§3 商品编码口径)
  name        String
  category    ProductCategory
  brand       String?
  baseUnit    String // 主单位(箱)
  minUnit     String @default("瓶") // 最小单位
  packSize    Int // 整散换算: 1 主单位 = packSize 最小单位
  barcode     String?
  abv         Float? // 度数
  origin      String?
  supplier    String?
  specText    String? // 规格描述 500ml×6
  highValue   Boolean         @default(false) // 高值品→防盗调包标记
  status      ProductStatus   @default(ON_SALE)
  pinyinFirst String? // 首字搜索
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  tenant        Tenant          @relation(fields: [tenantId], references: [id])
  prices        Price[]
  customerPrice CustomerPrice[]
  batches       BatchStock[]
  ledger        InventoryLedger[]
  orderLines    OrderLine[]
  priceChanges  PriceChangeRequest[]
  purchaseLines PurchaseLine[]

  @@unique([tenantId, skuCode])
  @@index([tenantId, name])
  @@index([tenantId, category])
}

// ───────────────────────── P0-T11 五级价 + 一客一价 ─────────────────────────

// 五级价链 (R1): 成本→一批→二批→终端供货→零售指导 (全局价, 按商品×计价单位)
enum PriceLevelType {
  COST     // 成本价(内部, 仅老板/财务可见)
  TIER1    // 一批价
  TIER2    // 二批价
  TERMINAL // 终端供货价(默认对外)
  RETAIL   // 零售指导价
}

enum PriceUnit {
  BASE // 主单位价(箱价)
  MIN  // 最小单位价(瓶价)
}

model Price {
  id          String         @id @default(cuid())
  tenantId    String
  productId   String
  unit        PriceUnit
  levelType   PriceLevelType
  price       Decimal        @db.Decimal(12, 2)
  validFrom   DateTime @default(now()) // 版本化: 只新增不覆盖 (D08)
  validTo     DateTime?
  approvalRef String? // 调价审批单号
  note        String?
  createdBy   String
  createdAt   DateTime       @default(now())

  product Product @relation(fields: [productId], references: [id])

  @@unique([tenantId, productId, unit, levelType, validFrom])
  @@index([tenantId, productId, validFrom])
}

model CustomerPrice {
  id          String    @id @default(cuid())
  tenantId    String
  customerId  String
  productId   String
  unit        PriceUnit
  price       Decimal   @db.Decimal(12, 2)
  validFrom   DateTime  @default(now())
  validTo     DateTime?
  approvalRef String? // 专属价必须带审批单号(§3)
  note        String?
  createdBy   String
  createdAt   DateTime  @default(now())

  customer Customer @relation(fields: [customerId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])

  @@unique([tenantId, customerId, productId, unit, validFrom])
  @@index([tenantId, customerId, productId])
}

// ───────────────────────── P0-T12 客户档案 + 开户四步 ─────────────────────────

enum CustomerType {
  YANJIUDIAN // 烟酒店
  CHAOSHI    // 超市
  CANYIN     // 餐饮
  PIFA       // 批发
  YECHANG    // 夜场
  QIYE       // 企事业单位
  QITA       // 其他
}

enum SettlementType {
  CASH    // 现结(额度0 款到发货)
  MONTHLY // 月结
}

enum SignMode {
  E_SIGN // 网签
  PAPER  // 纸单(打印送货单+回录)
}

enum OnboardingStatus {
  REP_DRAFT      // ①业务员录入
  CLERK_CONFIRMED // ②内勤确认
  PENDING_OWNER  // ③待老板终审
  ACTIVE         // ④终审通过(可自主下单)
  REJECTED
}

enum LicenseStatus {
  OK
  PENDING // 待补证(15天宽限, 超期冻结自主下单)
}

enum CustomerStatus {
  ACTIVE
  DISABLED // 禁用: 禁自主下单, 不禁纸单回录 (D12)
}

model Customer {
  id             String           @id @default(cuid())
  tenantId       String
  code           String // 客户编码, 唯一键
  name           String
  type           CustomerType
  contact        String?
  phone          String
  region         String?
  address        String
  abcLevel       String? // A/B/C
  settlement     SettlementType  @default(MONTHLY)
  termsDays      Int              @default(30) // 账期天数
  creditLimit    Decimal          @default(0) @db.Decimal(12, 2)
  minOrderAmount Decimal          @default(0) @db.Decimal(12, 2) // 起送量
  receivingWindow String? // 收货时段
  signMode       SignMode         @default(E_SIGN)
  printerModel   String?
  salespersonId  String? // 归属业务员(绩效锚 D5)
  bossPhone      String?
  licenseNo      String?
  licenseStatus  LicenseStatus    @default(PENDING)
  onboarding     OnboardingStatus @default(REP_DRAFT)
  status         CustomerStatus   @default(ACTIVE)
  note           String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  tenant        Tenant           @relation(fields: [tenantId], references: [id])
  salesperson   User?            @relation("CustomerSalesperson", fields: [salespersonId], references: [id])
  loginUsers    User[]           @relation("CustomerLoginUser")
  packageRecords PackageRecord[]
  prices        CustomerPrice[]
  orders        SalesOrder[]
  receivables   Receivable[]
  returns       ReturnOrder[]
  rebateSchemes RebateScheme[]
  rebateSettlements RebateSettlement[]
  payments      Payment[]

  @@unique([tenantId, code])
  @@index([tenantId, name])
  @@index([tenantId, salespersonId])
}

// ───────────────────────── P0-T22 库存: 批次 + 不可变流水 (B4) ─────────────────────────

model BatchStock {
  id           String    @id @default(cuid())
  tenantId     String
  productId    String
  batchNo      String // 非批次商品 = "期初"(模板口径)
  produceDate  DateTime?
  expiryDate   DateTime? // 啤酒/效期品必填, 已过期拒入(§3)
  location     String? // 库位(高值品锁定区)
  unitCost     Decimal   @db.Decimal(12, 4) // 成本单价(移动加权 R7 的输入)
  snapshotDate DateTime? // 期初盘点基准日(全批唯一硬校验)
  isInitial    Boolean   @default(false)
  createdAt    DateTime  @default(now())

  product   Product            @relation(fields: [productId], references: [id])
  ledger    InventoryLedger[]
  outbound  OutboundLine[]
  stocktakeLines StocktakeLine[]

  @@unique([tenantId, productId, batchNo])
  @@index([tenantId, productId])
}

enum LedgerDirection {
  IN
  OUT
}

enum InventoryRefType {
  INITIAL_IMPORT // 期初导入
  OUTBOUND       // 出库
  REJECT_RETURN  // 拒收回冲
  RETURN_IN      // 退货原批次回冲(P1-T03)
  PURCHASE_IN    // 采购收货入库(P1-T06)
  REVERSAL_IN    // 红字冲销回冲
  ADJUST         // 盘差调账(P1-07 前仅出库修正)
}

// append-only 库存流水: 任意时点库存 = SUM(IN) - SUM(OUT) 可重放重建 (B4)
model InventoryLedger {
  id        String           @id @default(cuid())
  tenantId  String
  productId String
  batchId   String
  direction LedgerDirection
  qty       Decimal          @db.Decimal(14, 3) // 最小单位数量
  refType   InventoryRefType
  refNo     String? // 关联单据号(订单号/批次号)
  note      String?
  createdBy String
  createdAt DateTime         @default(now())

  product Product    @relation(fields: [productId], references: [id])
  batch   BatchStock @relation(fields: [batchId], references: [id])

  @@index([tenantId, productId, createdAt])
  @@index([tenantId, refType, refNo])
}

// ───────────────────────── P0-T20~T25 订单主线 ─────────────────────────

enum OrderSource {
  CLERK   // 内勤开单
  REP     // 业务员代下
  CUSTOMER // 客户商城(文字)
}

// P0-C 统一状态机 (转换白名单见 src/statemachine/order-state.ts)
// 待确认→已确认→出库→配送→签收→销账 / 取消 / 拒收
enum OrderStatus {
  PENDING_CONFIRM
  CONFIRMED
  OUTBOUND
  DELIVERING
  SIGNED
  SETTLED
  CANCELLED
  REJECTED
}

model SalesOrder {
  id               String       @id @default(cuid())
  tenantId         String
  orderNo          String
  customerId       String
  customerName     String // 快照
  salespersonId    String? // 归属业务员快照(D5, 下单时点固化)
  source           OrderSource
  signMode         SignMode
  status           OrderStatus
  totalAmount      Decimal      @default(0) @db.Decimal(12, 2) // 含红字行后的净额(仅由服务端重算)
  addressSnapshot  String
  deliveryDate     DateTime? // 指定配送时段(D1 特单信号③)
  precheck         Json? // 审单预检四要素结果留痕(P0-T21)
  specialApproved  Boolean      @default(false) // 特批放行
  cancelReason     String?
  createdById      String
  confirmedAt      DateTime?
  outboundAt       DateTime?
  signedAt         DateTime?
  settledAt        DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  tenant     Tenant            @relation(fields: [tenantId], references: [id])
  customer   Customer          @relation(fields: [customerId], references: [id])
  createdBy  User              @relation("OrderCreator", fields: [createdById], references: [id])
  lines      OrderLine[]
  outbounds  Outbound[]
  signature  SignatureRecord?
  returns    ReturnOrder[]

  @@unique([tenantId, orderNo])
  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@index([tenantId, customerId])
}

// B3: 已落单行禁 UPDATE(金额/单价) — 改单唯一合法路径 = 红字冲销行(负数量, reversalOfId 关联原行) + 新行
enum OrderPriceType {
  CUSTOMER_EXCLUSIVE // 客户专属价
  TIER1
  TIER2
  TERMINAL
  RETAIL
  SPECIAL // 特批价(需审批)
  MANUAL  // 内勤手工价(留痕)
}

model OrderLine {
  id             String         @id @default(cuid())
  tenantId       String
  orderId        String
  productId      String
  productName    String // 商品快照(P0-T11 价格快照物理脱钩)
  specText       String?
  unit           PriceUnit
  conversionRate Int // 换算率快照(1主=N最小)
  qty            Decimal        @db.Decimal(14, 3)
  unitPrice      Decimal        @db.Decimal(12, 2) // 成交价快照
  amount         Decimal        @db.Decimal(12, 2) // = qty*unitPrice (服务端算)
  priceType      OrderPriceType
  priceVersion   String // 价格行 id+validFrom 指纹(快照溯源)
  promoNote      String?
  isGift         Boolean        @default(false) // 赠品行 0 单价参与库存扣减(D02 四不口径)
  reversalOfId   String? // 红字冲销: 指向被冲销的原行
  createdById    String
  createdAt      DateTime       @default(now())

  order      SalesOrder   @relation(fields: [orderId], references: [id])
  product    Product      @relation(fields: [productId], references: [id])
  reversalOf OrderLine?   @relation("OrderLineReversal", fields: [reversalOfId], references: [id])
  reversedBy OrderLine[]  @relation("OrderLineReversal")
  outboundLines OutboundLine[]
  returnLines ReturnLine[]

  @@index([tenantId, orderId])
  @@index([reversalOfId])
}

// ═══════════ P1-T01 审批中心: 五条线统一 (D01: 金额路由, ≤2000内勤 >2000/低于成本老板; 超时24h退回不自动通过) ═══════════
enum ApprovalLine {
  CREDIT_RELEASE // 信用超额放行(原 P0 特批)
  PRICE_SPECIAL  // 特单/客户价格审批
  PRICE_CHANGE   // 调价审批(F7, P1-T05)
  PURCHASE       // 采购审批(P1-T06)
  EXPENSE        // 运营费审批(P1)
  RETURN         // 退货审批(P1-T03)
  STOCKTAKE      // 盘点差异调账审批(P1-T07, Q11 超阈值报老板)
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED_24H // 超时24h自动退回(不自动通过, D01)
}

model ApprovalRecord {
  id           String         @id @default(cuid())
  tenantId     String
  line         ApprovalLine
  entityType   String // ORDER / SPECIAL_ORDER / PRICE_CHANGE / PURCHASE / EXPENSE / RETURN
  entityId     String
  title        String // 待办列表展示
  amount       Decimal?       @db.Decimal(12, 2)
  reason       String // 申请理由
  payload      Json? // 线内扩展(调价差异清单/特单字段快照等)
  applicantId  String
  applicant    User           @relation("ApprovalApplicant", fields: [applicantId], references: [id])
  status       ApprovalStatus @default(PENDING)
  approverId   String? // 实际审批人(金额路由: 2000 阈值可配 special_approve_threshold)
  decidedAt    DateTime?
  createdAt    DateTime       @default(now())

  @@index([tenantId, status, createdAt])
  @@index([tenantId, line, entityType, entityId])
}

// ───────────────────────── P0-T22 出库单 ─────────────────────────

enum OutboundStatus {
  PICKING  // 拣货中(FIFO 建议批次)
  CONFIRMED // 复核出库(生成库存流水)
}

model Outbound {
  id          String         @id @default(cuid())
  tenantId    String
  outboundNo  String
  orderId     String
  status      OutboundStatus @default(PICKING)
  pickerId    String?
  checkerId   String? // 复核人
  note        String?
  confirmedAt DateTime?
  createdAt   DateTime       @default(now())

  order SalesOrder     @relation(fields: [orderId], references: [id])
  lines OutboundLine[]

  @@unique([tenantId, outboundNo])
  @@index([tenantId, orderId])
}

model OutboundLine {
  id          String  @id @default(cuid())
  tenantId    String
  outboundId  String
  orderLineId String
  batchId     String
  qty         Decimal @db.Decimal(14, 3) // 最小单位

  outbound  Outbound   @relation(fields: [outboundId], references: [id])
  orderLine OrderLine  @relation(fields: [orderLineId], references: [id])
  batch     BatchStock @relation(fields: [batchId], references: [id])

  @@index([tenantId, outboundId])
}

// ───────────────────────── P0-T23 签收(append-only 凭证, P1-6) ─────────────────────────

enum SignatureType {
  E_SIGN // 电子网签
  PHOTO  // 拍照签收
  PAPER  // 纸单回录(P0-T24)
}

model SignatureRecord {
  id             String        @id @default(cuid())
  tenantId       String
  orderId        String
  type           SignatureType
  signerName     String?
  signedAt       DateTime      @default(now())
  photoUrl       String? // 凭证存对象存储
  signatureData  String?
  deviceInfo     String?
  recordedById   String // 回录人(D+1 时限)
  returnPackages Json? // 回包装回填 [{category, qty}] P0 仅记录
  createdAt      DateTime      @default(now())

  order SalesOrder @relation(fields: [tenantId, orderId], references: [tenantId, id])

  @@unique([tenantId, orderId])
}

// ───────────────────────── P0-T30~T31 应收/收款/销账 (B4 流水投影) ─────────────────────────

enum ReceivableSourceType {
  ORDER   // 签收生成(起算=签收完成时刻 D4)
  INITIAL // 期初历史挂账(不进 SalesOrder)
}

model Receivable {
  id           String               @id @default(cuid())
  tenantId     String
  sourceType   ReceivableSourceType
  sourceDocNo  String // 订单号 / 原始单据号
  customerId   String
  total        Decimal              @db.Decimal(12, 2) // 不可变(B3 同原则, 差异走红字)
  dueDate      DateTime // 生成日+账期天数; 现结=生成即到期
  generatedAt  DateTime @default(now())
  disputeFlag  Boolean              @default(false) // 争议/死账: 不进账龄分档与提醒(D11)
  note         String?
  archivedAt   DateTime? // T32 软归档: 已结6个月后归档, 客户查询过滤, 后台可恢复(禁物理删除)
  archivedById String?
  createdAt    DateTime             @default(now())

  tenant   Tenant             @relation(fields: [tenantId], references: [id])
  customer Customer           @relation(fields: [customerId], references: [id])
  // 注: 原 order SalesOrder? @relation(fields:[tenantId,sourceDocNo]...) 复合外键已移除——
  // 期初应收(sourceType=INITIAL)的单号不存在于 SalesOrder, NOT NULL FK 必然违反。
  // 订单关联在应用层按 sourceType='ORDER' && sourceDocNo=orderNo 查询。
  ledger   ReceivableLedger[]

  @@unique([tenantId, sourceType, sourceDocNo])
  @@index([tenantId, customerId, dueDate])
}

enum PaymentStatus {
  REPORTED // 业务员上报(F9 ①)
  CONFIRMED // 内勤录入确认(F9 ②→销账)
  CANCELLED // 冲正=红字, 禁改原单
}

model Payment {
  id            String        @id @default(cuid())
  tenantId      String
  paymentNo     String
  customerId    String
  amount        Decimal       @db.Decimal(12, 2)
  kind          PaymentKind   @default(PAYMENT) // T03: 收款/抹零/坏账
  receivableId  String? // kind=WAIVE/BAD_DEBT 时的目标应收单(审批后写 WAIVE/WRITEOFF 流水)
  method        String? // 现金/转账/返利抵扣(D02)
  voucher       String? // 凭证
  reportedById  String? // 业务员上报
  enteredById   String? // 内勤录入
  status        PaymentStatus @default(REPORTED)
  idemKey       String? // Idempotency-Key (P0-03 幂等)
  note          String?
  confirmedAt   DateTime?
  createdAt     DateTime      @default(now())

  tenant     Tenant            @relation(fields: [tenantId], references: [id])
  customer   Customer          @relation(fields: [customerId], references: [id])
  reportedBy User?             @relation("PaymentReporter", fields: [reportedById], references: [id])
  enteredBy  User?             @relation("PaymentClerk", fields: [enteredById], references: [id])
  ledger     ReceivableLedger[]

  @@unique([tenantId, paymentNo])
  @@unique([tenantId, idemKey])
  @@index([tenantId, customerId])
}

enum ArLedgerDirection {
  CHARGE        // 应收发生(签收/期初)
  SETTLE        // 收款核销(FIFO)
  REBATE_OFFSET // 返利抵扣(c 直接冲应收)
  WAIVE         // 抹零减免(审批通过后核减, 单笔/月累计上限)
  WRITEOFF      // 坏账核销(老板审批)
  RETURN_CREDIT // 退货冲减(P1-T03, 不改原单金额)
  REVERSAL      // 红字冲正
}

enum PaymentKind {
  PAYMENT   // 正常收款(F9)
  WAIVE     // 抹零(内勤发起→老板审批)
  BAD_DEBT  // 坏账核销(老板直接执行)
}

// append-only 应收流水: 余额 = total - SUM(SETTLE+REBATE_OFFSET) 可重放 (B4)
model ReceivableLedger {
  id            String            @id @default(cuid())
  tenantId      String
  receivableId  String
  paymentId     String?
  direction     ArLedgerDirection
  amount        Decimal           @db.Decimal(12, 2)
  note          String?
  createdBy     String
  createdAt     DateTime          @default(now())

  receivable Receivable @relation(fields: [receivableId], references: [id])
  payment    Payment?   @relation(fields: [paymentId], references: [id])

  @@index([tenantId, receivableId, createdAt])
}

// ═══════════ P1-T02 特单 (F8: 全员下单——品名/数量/价格/配送时间/地址/联系人/收款人及时间 + 婚宴宴席单) ═══════════
// 红线: 未经定价审批不可出货 → status=APPROVED 才可转正式订单(PENDING_PRICE→APPROVED 闸门)
enum SpecialOrderStatus {
  DRAFT
  PENDING_PRICE // 待定价审批(走审批中心 PRICE_SPECIAL 线)
  APPROVED
  CONVERTED // 已转正式订单
  REJECTED
}

model SpecialOrder {
  id            String             @id @default(cuid())
  tenantId      String
  specialNo     String
  title         String // "XX婚宴用酒" 等
  customerId    String? // 可无档案客户(现金散客)
  customerName  String
  isBanquet     Boolean            @default(false) // 宴席/活动用酒(D1 信号④)
  eventDate     DateTime? // 宴席日期
  venue         String? // 地点
  contactName   String
  contactPhone  String
  address       String
  deliveryDate  DateTime? // 配送时段(D1 信号③)
  payeeName     String? // 收款人及时间(F8)
  payDueDate    DateTime?
  note          String?
  status        SpecialOrderStatus @default(DRAFT)
  convertedOrderId String? // 转正式订单后回填
  createdById   String
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  lines SpecialOrderLine[]

  @@unique([tenantId, specialNo])
  @@index([tenantId, status])
}

// 特单行: 可引用商品或自由品名(杂酒/赠品组合); 价格待审批(D1 信号① 低于可用价即特单)
model SpecialOrderLine {
  id          String  @id @default(cuid())
  tenantId    String
  specialOrderId String
  productId   String? // 自由品名时为空
  productName String
  specText    String?
  unit        String
  qty         Decimal @db.Decimal(14, 3)
  price       Decimal @db.Decimal(12, 2)
  note        String?

  specialOrder SpecialOrder @relation(fields: [specialOrderId], references: [id])

  @@index([tenantId, specialOrderId])
}

// ═══════════ P1-T03 退货销户 (F10 + R4 数量只能多不能少 + D13: 签收后48h窗口/关联原单/老板审批) ═══════════
enum ReturnStatus {
  PENDING_REVIEW // 待审批(走审批中心 RETURN 线, 老板)
  APPROVED
  RECEIVED // 仓库收货, 批次回冲完成, 应收已重算
  CANCELLED
}

model ReturnOrder {
  id              String       @id @default(cuid())
  tenantId        String
  returnNo        String
  sourceOrderId   String // 关联原单(必填, D13)
  customerId      String
  reason          String
  status          ReturnStatus @default(PENDING_REVIEW)
  receivedAt      DateTime?
  receivedById    String?
  createdById     String
  createdAt       DateTime     @default(now())

  order    SalesOrder   @relation(fields: [sourceOrderId], references: [id])
  customer Customer     @relation(fields: [customerId], references: [id])
  lines    ReturnLine[]

  @@unique([tenantId, returnNo])
  @@index([tenantId, status])
}

// R4 写一次+只增: 行数量禁 UPDATE 减少(Prisma 守卫拦截 + API 层校验), 增量走追加行
model ReturnLine {
  id           String  @id @default(cuid())
  tenantId     String
  returnOrderId String
  orderLineId  String // 退的是原订单哪一行
  productId    String
  batchId      String? // 原批次回冲(仓库收货时定)
  qty          Decimal @db.Decimal(14, 3)
  note         String?

  returnOrder ReturnOrder @relation(fields: [returnOrderId], references: [id])
  orderLine   OrderLine  @relation(fields: [orderLineId], references: [id])

  @@index([tenantId, returnOrderId])
}

// ═══════════ P1-T05 调价引擎 (F7 + D08: 只新增版本不覆盖历史 + R7 存货增贬值不做自动估值) ═══════════
enum PriceChangeStatus {
  DRAFT
  PENDING // 待审批(PRICE_CHANGE 线)
  APPROVED
  EFFECTIVE // 已生效(新价格版本行已落)
  REJECTED
  CANCELLED
}

model PriceChangeRequest {
  id            String            @id @default(cuid())
  tenantId      String
  productId     String
  unit          PriceUnit
  levelType     PriceLevelType
  oldPrice      Decimal           @db.Decimal(12, 2) // 发起时最新生效价快照
  newPrice      Decimal           @db.Decimal(12, 2)
  effectiveDate DateTime // 生效日=新版本 validFrom
  reason        String
  stockImpact   Json? // 存货增贬值测算(在库量×价差, 仅登记不自动调账 D15/R7)
  customerSync  Boolean           @default(false) // 客户专属价联动提示(不自动改专属价)
  status        PriceChangeStatus @default(DRAFT)
  approvalId    String?
  createdById   String
  effectuatedAt DateTime?
  createdAt     DateTime          @default(now())

  product Product @relation(fields: [productId], references: [id])

  @@index([tenantId, status])
}

// ═══════════ P1-T04 回包装闭环 (有单回填 + F11 无单回收 + 周转箱押金台账, 押金单价 cfg) ═══════════
enum PackageRecordType {
  WITH_ORDER // 签收回填(订单关联)
  STANDALONE // F11 无单回收
  OUT        // 押金退付冲减
}

model PackageRecord {
  id           String           @id @default(cuid())
  tenantId     String
  customerId   String
  category     String // 周转箱/啤酒瓶/白酒盒…
  qty          Int
  type         PackageRecordType
  orderId      String? // 有单回填关联
  depositPaid  Decimal          @default(0) @db.Decimal(12, 2) // 按品类押金单价×数量
  note         String?
  recordedById String
  createdAt    DateTime         @default(now())

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([tenantId, customerId, category])
  @@index([tenantId, createdAt])
}

// ═══════════ P1-T06 采购双流程 (F3 先付 / F4 后付: 审批节点位置不同) + 成本价录入 ═══════════
enum PurchaseType {
  PREPAID  // F3 先付: 审批→付款→收货
  POSTPAID // F4 后付: 审批→收货→付款
}

enum PurchaseStatus {
  DRAFT
  PENDING_APPROVAL // PURCHASE 审批线
  APPROVED
  PAID
  RECEIVED // 收货入库完成(IN 流水+批次)
  CANCELLED
}

model PurchaseOrder {
  id          String         @id @default(cuid())
  tenantId    String
  purNo       String
  supplier    String
  type        PurchaseType
  status      PurchaseStatus @default(DRAFT)
  totalAmount Decimal        @default(0) @db.Decimal(12, 2)
  payeeNote   String? // 收款账户/凭据
  paidAt      DateTime?
  receivedAt  DateTime?
  note        String?
  createdById String
  createdAt   DateTime       @default(now())

  lines PurchaseLine[]

  @@unique([tenantId, purNo])
  @@index([tenantId, status])
}

// 收货入库: 按(商品,批次)建/补 BatchStock + IN 流水(refType=PURCHASE_IN) + 成本价新版本(COST)
model PurchaseLine {
  id          String  @id @default(cuid())
  tenantId    String
  purchaseId  String
  productId   String
  batchNo     String
  qty         Decimal @db.Decimal(14, 3) // 最小单位
  unitCost    Decimal @db.Decimal(12, 4) // 采购成本单价(录入, 落 COST 价版本)
  produceDate DateTime?
  expiryDate  DateTime?

  purchase PurchaseOrder @relation(fields: [purchaseId], references: [id])
  product  Product      @relation(fields: [productId], references: [id])

  @@index([tenantId, purchaseId])
}

// ═══════════ P1-T07 盘点报损 (Q11 分工: 仓管盘→内勤核对→超阈值报老板→调账; 双签留痕) ═══════════
enum StocktakeType {
  SPOT // 抽盘
  FULL // 月末大盘
}

enum StocktakeStatus {
  DRAFT // 建单
  COUNTED // 仓管录完实盘
  RECONCILED // 内勤核对, 差异清单生成
  PENDING_APPROVAL // 差异超阈值→老板审批(STOCKTAKE 线)
  ADJUSTED // 调账完成(ADJUST 流水落账)
  CANCELLED
}

model Stocktake {
  id             String           @id @default(cuid())
  tenantId       String
  takeNo         String
  type           StocktakeType
  status         StocktakeStatus  @default(DRAFT)
  countedById    String // 仓管(盘)
  reconciledById String? // 内勤(核)
  thresholdOver  Boolean          @default(false) // 差异金额超阈值标记
  diffAmount     Decimal?         @db.Decimal(12, 2) // 差异金额(成本口径)
  note           String?
  countedAt      DateTime?
  reconciledAt   DateTime?
  adjustedAt     DateTime?
  createdAt      DateTime         @default(now())

  lines StocktakeLine[]

  @@unique([tenantId, takeNo])
  @@index([tenantId, status])
}

model StocktakeLine {
  id          String  @id @default(cuid())
  tenantId    String
  stocktakeId String
  productId   String
  batchId     String
  systemQty   Decimal @db.Decimal(14, 3) // 盘点时刻账面(快照)
  countedQty  Decimal @db.Decimal(14, 3) // 实盘
  unitCost    Decimal @db.Decimal(12, 4)

  stocktake Stocktake @relation(fields: [stocktakeId], references: [id])
  batch     BatchStock @relation(fields: [batchId], references: [id])

  @@index([tenantId, stocktakeId])
}

// ═══════════ P1-T08 优惠三式 (D02: b/c 互斥, c 直接冲应收; 赠品四不; 月末核算货补/票折) ═══════════
enum RebateType {
  B // 除瓶箱后 5%-50% 月末核算
  C // 定扣货款(直接冲应收)
}

enum RebateSettleType {
  GOODS // 货补(走随单赠下单, 不反改原单)
  INVOICE // 票折(REBATE_OFFSET 流水冲应收)
}

model RebateScheme {
  id          String   @id @default(cuid())
  tenantId    String
  customerId  String
  type        RebateType
  rate        Decimal  @db.Decimal(5, 4) // 0.05-0.50
  note        String?
  validFrom   DateTime @default(now())
  validTo     DateTime?
  closedAt    DateTime?
  createdById String
  createdAt   DateTime @default(now())
  customer    Customer @relation(fields: [customerId], references: [id])

  @@index([tenantId, customerId, validFrom])
}

model RebateSettlement {
  id           String            @id @default(cuid())
  tenantId     String
  customerId   String
  schemeId     String
  period       String // YYYY-MM
  baseAmount   Decimal           @db.Decimal(12, 2) // 计提基数(当月回款−瓶箱押金口径)
  rebateAmount Decimal           @db.Decimal(12, 2)
  settleType   RebateSettleType
  status       String            @default("DRAFT") // DRAFT→CONFIRMED
  confirmedAt  DateTime?
  note         String?
  createdById  String
  createdAt    DateTime          @default(now())
  customer     Customer          @relation(fields: [customerId], references: [id])

  @@unique([tenantId, customerId, period])
  @@index([tenantId, period])
}

// ═══════════ P1-T09 绩效工资 (D5: 回款70/拜访20/新客10, 退货当期冲减不回算; 工资表可复算) ═══════════
model Payroll {
  id          String   @id @default(cuid())
  tenantId    String
  month       String // YYYY-MM
  items       Json // [{repId,name,paymentAmount,newCustomers,visitCount,returnDeduction,commission,baseSalary,total}]
  totalAmount Decimal  @db.Decimal(12, 2)
  status      String   @default("DRAFT") // DRAFT→CONFIRMED
  confirmedAt DateTime?
  generatedBy String
  createdAt   DateTime @default(now())

  @@unique([tenantId, month])
}

// ───────────────────────── P0-T03 审计日志 (B2 哈希链) ─────────────────────────

model AuditLog {
  id           String   @id @default(cuid())
  tenantId     String
  userId       String?
  username     String
  role         String
  action       String // 枚举见 AuditAction 常量(改价/信用放行/销账/抹零/出库/签收/拒收/改单/导入/特批/期初迁移…)
  entityType   String
  entityId     String?
  before       Json? // 动作前值
  after        Json? // 动作后值
  ip           String?
  channel      String   @default("web")
  prevRowHash  String // 哈希链: sha256(prevRowHash + 本行内容)
  rowHash      String
  createdAt    DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User?  @relation(fields: [userId], references: [id])

  @@index([tenantId, createdAt])
  @@index([tenantId, entityType, entityId])
  @@index([tenantId, userId, createdAt])
}

// ───────────────────────── P0-T13 导入批次 + 幂等 ─────────────────────────

enum ImportKind {
  PRODUCT
  CUSTOMER
  PRICE
  INVENTORY
  RECEIVABLE
}

enum ImportStatus {
  UPLOADED
  PREVIEWED
  COMMITTED
  ROLLED_BACK
}

enum ImportRowLevel {
  REJECT_BATCH // R-拒批: 整批不写入
  REJECT_ROW // R-拒行: 该行进差异报告
  WARN // R-警告: 待商户批注后放行
}

model ImportBatch {
  id            String       @id @default(cuid())
  tenantId      String
  batchNo       String
  kind          ImportKind
  fileName      String
  status        ImportStatus @default(UPLOADED)
  totalRows     Int          @default(0)
  passedRows    Int          @default(0)
  rejectedRows  Int          @default(0)
  warnedRows    Int          @default(0)
  snapshotDate  DateTime? // 期初库存盘点基准日(全批唯一)
  report        Json? // 差异报告汇总
  createdBy     String
  committedAt   DateTime?
  rolledBackAt  DateTime?
  createdAt     DateTime     @default(now())

  rowErrors ImportRowError[]

  @@unique([tenantId, batchNo])
  @@index([tenantId, kind, status])
}

model ImportRowError {
  id         String          @id @default(cuid())
  tenantId   String
  batchId    String
  rowNo      Int
  rowKey     String? // 商品编码/客户编码/原始单据号…
  level      ImportRowLevel
  reasonCode String // DUP_KEY / REF_MISS / ENUM_INVALID / DATE_FMT / AMOUNT_NEG / DATE_ORDER / RECEIVED_GT_TOTAL / OPEN_NEQ / REQUIRED…
  message    String
  raw        Json?

  batch ImportBatch @relation(fields: [batchId], references: [id])

  @@index([tenantId, batchId])
}

// P0-03 幂等键: 资金/库存写接口必带, 服务端唯一索引兜底, 重试不双写
model IdempotencyRecord {
  id              String   @id @default(cuid())
  tenantId        String
  key             String
  endpoint        String
  requestHash     String
  responseSummary Json?
  createdBy       String
  createdAt       DateTime @default(now())

  @@unique([tenantId, key])
}

// 业务规则配置(数值型默认值商户签字可否决, 业务适配清单§0): T03 抹零上限/T51 账期提醒N天/特批阈值T等
model SystemConfig {
  id        String   @id @default(cuid())
  tenantId  String
  key       String // waive_single_max / waive_monthly_max / remind_days_before / special_approve_threshold
  value     Json
  note      String?
  updatedBy String
  updatedAt DateTime @updatedAt

  @@unique([tenantId, key])
}
