{
  "name": "liquor-distribution",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev:admin": "pnpm --filter @liquor/admin dev",
    "build:admin": "pnpm --filter @liquor/admin build",
    "dev:miniapp": "pnpm --filter @liquor/miniapp dev:weapp",
    "build:miniapp": "pnpm --filter @liquor/miniapp build:weapp && pnpm --filter @liquor/miniapp build:h5",
    "check:bundle": "pnpm --filter @liquor/miniapp check:bundle"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.4",
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.74.0"
  },
  "devDependencies": {
    "turbo": "^2.0.0"
  }
}
